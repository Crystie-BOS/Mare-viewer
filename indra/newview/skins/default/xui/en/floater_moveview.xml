<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- MARE v1.1.0: Firestorm-style compact movement controls.
     Layout mirrors the Firestorm camera floater:
       - Top strip  (36px, fixed)   : Walk / Run / Fly mode buttons
       - Left panel (auto)          : joystick_move_fwd  — oval widget,  forward/back + turn
       - Centre col (22px, fixed)   : Up / Down buttons  — fly up / crouch / jump
       - Right panel (auto)         : joystick_move_strafe — crosshair,  slide left/right
     reshape() in llmoveview.cpp keeps the mode strip at 36px and lets the
     joystick area fill the remaining content height.  The layout_stack
     divides the joystick area into the three columns automatically.        -->
<floater
 positioning="specified"
 right="-905"
 bottom="-30"
 legacy_header_height="18"
 bg_alpha_image_overlay="LtGray_50"
 chrome="true"
 can_dock="false"
 can_minimize="true"
 can_close="true"
 can_resize="true"
 min_height="185"
 min_width="185"
 follows="bottom"
 height="270"
 layout="topleft"
 name="move_floater"
 help_topic="move_floater"
 save_rect="true"
 save_visibility="true"
 save_dock_state="true"
 width="230">

    <!-- ── Tooltip strings (used by initModeTooltips) ── -->
    <string name="walk_forward_tooltip">Walk or turn (drag to move)</string>
    <string name="walk_back_tooltip">Walk Backwards (press Down Arrow or S)</string>
    <string name="walk_left_tooltip">Slide left/right (drag to strafe)</string>
    <string name="walk_right_tooltip">Walk right (press Shift + Right Arrow or D)</string>
    <string name="run_forward_tooltip">Run or turn (drag to move)</string>
    <string name="run_back_tooltip">Run Backwards (press Down Arrow or S)</string>
    <string name="run_left_tooltip">Run left/right (drag to strafe)</string>
    <string name="run_right_tooltip">Run right (press Shift + Right Arrow or D)</string>
    <string name="fly_forward_tooltip">Fly forward/back or turn (drag)</string>
    <string name="fly_back_tooltip">Fly Backwards (press Down Arrow or S)</string>
    <string name="fly_left_tooltip">Fly sideways (drag to strafe)</string>
    <string name="fly_right_tooltip">Fly right (press Shift + Right Arrow or D)</string>
    <string name="fly_up_tooltip">Fly up (press E)</string>
    <string name="fly_down_tooltip">Fly down (press C)</string>
    <string name="jump_tooltip">Jump (press E)</string>
    <string name="crouch_tooltip">Crouch (press C)</string>
    <string name="walk_title">Walk</string>
    <string name="run_title">Run</string>
    <string name="fly_title">Fly</string>

    <!-- ══════════════════════════════════════════════════════════
         TOP STRIP — Walk / Run / Fly mode toggle buttons (fixed 36px)
         Mirrors Firestorm's camera view-preset row.
         reshape() positions this panel; initial XML coords used for first frame.
         ══════════════════════════════════════════════════════════ -->
    <panel
     border="false"
     height="36"
     layout="topleft"
     left="0"
     name="panel_modes"
     top="18"
     width="230">
        <button
         follows="left|top"
         height="28"
         image_overlay="Move_Walk_Off"
         image_selected="PushButton_Selected_Press"
         label=""
         layout="topleft"
         left="4"
         name="mode_walk_btn"
         pad_right="0"
         tool_tip="Walking mode"
         top="4"
         width="28" />
        <button
         follows="left|top"
         height="28"
         image_overlay="Move_Run_Off"
         image_selected="PushButton_Selected_Press"
         label=""
         layout="topleft"
         left_delta="30"
         name="mode_run_btn"
         pad_right="0"
         tool_tip="Running mode"
         top="4"
         width="28" />
        <button
         follows="left|top"
         height="28"
         image_overlay="Move_Fly_Off"
         image_selected="PushButton_Selected_Press"
         label=""
         layout="topleft"
         left_delta="30"
         name="mode_fly_btn"
         pad_right="0"
         tool_tip="Flying mode (press [Home] or F)"
         top="4"
         width="28" />
    </panel>

    <!-- ══════════════════════════════════════════════════════════
         JOYSTICK AREA — fills all space below the mode strip.
         reshape() positions this panel to content_h - 36px tall.
         The internal layout_stack divides it into three columns:
           left  = oval movement joystick  (forward/back/turn)
           centre= Up / Down buttons
           right = crosshair strafe joystick
         ══════════════════════════════════════════════════════════ -->
    <panel
     border="false"
     height="216"
     follows="all"
     layout="topleft"
     left="0"
     mouse_opaque="false"
     name="panel_actions"
     top="54"
     width="230">

        <layout_stack
         name="joystick_stack"
         orientation="horizontal"
         follows="all"
         left="4"
         top="4"
         width="222"
         height="208"
         border_size="0"
         bg_alpha_color="0 0 0 0">

            <!-- Left: oval orbit widget — forward / backward / turn -->
            <layout_panel
             name="move_orbit_panel"
             auto_resize="true"
             min_dim="60"
             width="99">
                <joystick_move_fwd
                 name="forward btn"
                 image_selected="Cam_Rotate_In"
                 image_unselected="Cam_Rotate_Out"
                 quadrant="origin"
                 scale_image="true"
                 follows="all"
                 layout="topleft"
                 label=""
                 left="0"
                 top="0"
                 width="99"
                 height="208"
                 tool_tip="Drag to walk forward/back, or turn" />
            </layout_panel>

            <!-- Centre: Up / Down buttons (like camera zoom +/-) -->
            <layout_panel
             name="updown_col"
             auto_resize="false"
             width="22"
             height="208">
                <button
                 name="move up btn"
                 follows="left|top"
                 layout="topleft"
                 label=""
                 left="2"
                 top="4"
                 width="18"
                 height="18"
                 image_unselected="AddItem_Off"
                 image_selected="AddItem_Press"
                 image_pressed_selected="AddItem_Press"
                 tool_tip="Fly up (press E)" />
                <button
                 name="move down btn"
                 follows="left|top"
                 layout="topleft"
                 label=""
                 left="2"
                 top_pad="8"
                 width="18"
                 height="18"
                 image_unselected="MinusItem_Off"
                 image_selected="MinusItem_Press"
                 image_pressed_selected="MinusItem_Press"
                 tool_tip="Fly down (press C)" />
            </layout_panel>

            <!-- Right: crosshair strafe widget — slide left/right (+ fwd/back) -->
            <layout_panel
             name="move_strafe_panel"
             auto_resize="true"
             min_dim="60"
             width="99">
                <joystick_move_strafe
                 name="move left btn"
                 image_selected="Cam_Tracking_In"
                 image_unselected="Cam_Tracking_Out"
                 quadrant="origin"
                 scale_image="true"
                 follows="all"
                 layout="topleft"
                 label=""
                 left="0"
                 top="0"
                 width="99"
                 height="208"
                 tool_tip="Drag to slide / strafe in any direction" />
            </layout_panel>

        </layout_stack>
    </panel>
</floater>
